# Runtime data root. Keep this outside the Git repository in production.
# Relative paths are resolved from the project root.
APP_RUNTIME_ROOT=.app_runtime

# Persistent production backend (recommended on Render).
DATABASE_URL=

# Optional exact public directory for direct Pushover PDF links. Render's
# RENDER_EXTERNAL_URL is detected automatically when this is empty.
# Example: https://your-app.onrender.com/app/static/reports
REPORT_PUBLIC_BASE_URL=
REPORT_SCHEDULER_POLL_SECONDS=60

# v18.7.2 News & Sentiment Intelligence (optional)
NEWSAPI_KEY=
NEWSAPI_PLAN=Developer
NEWSAPI_DAILY_BUDGET=60
NEWSAPI_SHARED_CACHE_TTL_HOURS=12
NEWSAPI_MIN_INTERVAL_SECONDS=1.0
NEWSAPI_FALLBACK_ONLY=true
NEWSAPI_FALLBACK_MIN_EXISTING_ARTICLES=3
NEWSAPI_REVALIDATION_RESERVE=10
REPORT_REVALIDATION_HOURS=6
REPORT_REVALIDATION_MAX_ATTEMPTS=3
# Påkrevd for direkte SEC EDGAR Form 4-oppslag. Bruk firmanavn og kontaktadresse.
SEC_USER_AGENT=
NEWS_INTELLIGENCE_CACHE_TTL_HOURS=6
NEWS_INTELLIGENCE_LOOKBACK_DAYS=14

# v19.1.0 Operational traceability (optional tuning)
SOURCE_HEALTH_FAILURE_ALERT_THRESHOLD=3
SOURCE_HEALTH_FALLBACK_ALERT_THRESHOLD=3
SOURCE_HEALTH_VOLUME_LOW_RATIO=0.20
SOURCE_HEALTH_VOLUME_HIGH_RATIO=5.0

# v19.2.0 permanent storage policy
# auto: use PostgreSQL when DATABASE_URL is available. In production, set
# ALLOW_LOCAL_STORAGE_FALLBACK=false to prevent a silent local second truth.
STORAGE_MODE=auto
ALLOW_LOCAL_STORAGE_FALLBACK=false

# v19.14.2 runtime safety (fail-closed defaults)
APP_ENVIRONMENT=local
PAPER_TRADING_ENABLED=false
ALLOW_PAPER_TRADING_IN_TEST=false
RUNTIME_BACKGROUND_ENABLED=false
REPORT_SCHEDULER_ENABLED=false
ALLOW_BACKGROUND_IN_TEST=false
ALLOW_SCHEDULER_IN_TEST=false
ALLOW_NOTIFICATIONS_IN_TEST=false
ALLOW_DATABASE_IN_TEST=false

# v19.14.4 durable authentication. AUTH_DATABASE_URL is intentionally
# separate from DATABASE_URL, so a test service can persist users/sessions
# without access to production reports or portfolios.
AUTH_STORAGE_MODE=auto
AUTH_DATABASE_URL=
AUTH_REQUIRE_PERSISTENT=true
AUTH_STORAGE_ROOT=.app_runtime/data/auth
# Set true only when AUTH_STORAGE_ROOT is on a mounted persistent disk.
AUTH_STORAGE_PERSISTENT=false
# Optional explicit cookie namespace. Defaults to APP_ENVIRONMENT/service name.
AUTH_COOKIE_NAMESPACE=
# Recheck user/session version periodically without logging out on transient DB restarts.
AUTH_SESSION_RECHECK_SECONDS=60
# Set true only when APP_RUNTIME_ROOT is mounted persistently. Required before
# controlled Paper Buy testing when DATABASE_URL remains empty.
APP_RUNTIME_PERSISTENT=false
